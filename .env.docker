# =============================================================================
# Tow Truck Service — Docker Compose environment
# Used by: docker compose --env-file .env.docker up -d --build
# Replace placeholder secrets and URLs before public production use.
# =============================================================================

# --- Application (required) ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Generate production secrets: openssl rand -base64 32
AUTH_SECRET=docker-placeholder-auth-secret-minimum-32-characters
CRON_SECRET=docker-placeholder-cron-secret-min-16

# --- PostgreSQL (must match docker-compose postgres service) ---
POSTGRES_USER=towtruck
POSTGRES_PASSWORD=towtruck-docker-password-change-me
POSTGRES_DB=tow_truck_service
POSTGRES_PORT=5432

# --- App container port mapping (host:container) ---
APP_PORT=3000

# DATABASE_URL is injected by docker-compose.yml (postgres service hostname).
# Override only if using an external database:
# DATABASE_URL=postgresql://towtruck:towtruck-docker-password-change-me@postgres:5432/tow_truck_service?schema=public

# --- Google Maps (recommended — calculator & address autocomplete) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAWCcAtTyRL0RlZjXWKcEO_c3U8z0NJkL0
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# --- WhatsApp Business Cloud API (optional — Phase 9+) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Telegram Bot (optional — admin notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Email via Resend (optional — order notifications) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_ADMIN=admin@example.com

# --- Error monitoring (optional) ---
# SENTRY_DSN=
