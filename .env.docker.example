# Docker Compose environment — copy to .env.docker
# Usage: cp .env.docker.example .env.docker && docker compose up -d --build

# Application
NEXT_PUBLIC_APP_URL=https://evakuator24.biz.ua
AUTH_SECRET=replace-with-openssl-rand-base64-32-min-32-chars
AUTH_URL=https://evakuator24.biz.ua
CRON_SECRET=replace-with-openssl-rand-base64-32

# PostgreSQL (must match docker-compose postgres service)
POSTGRES_USER=towtruck
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tow_truck_service
POSTGRES_PORT=5432
APP_PORT=3000

# Google Maps (recommended)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp Business API (Phase 9+ — not connected yet)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional
SENTRY_DSN=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ADMIN=
