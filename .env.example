# =============================================================================
# Tow Truck Service — Development Environment
# Copy to .env.local and fill in values: cp .env.example .env.local
# =============================================================================

# --- Application (required) ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (required in production runtime) ---
# Neon PostgreSQL recommended: https://neon.tech
DATABASE_URL=postgresql://user:password@localhost:5432/tow_truck_service?schema=public

# --- Authentication (required in production runtime) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Must match your public URL in production
AUTH_URL=http://localhost:3000

# --- Google Maps (recommended — calculator & routes) ---
# Browser key (Maps JavaScript API + Places + Directions)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Legacy alias — optional if NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is set
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server key — for future server-side geocoding proxy (Phase 9+)
GOOGLE_MAPS_SERVER_KEY=

# --- WhatsApp Business Cloud API (optional — Phase 9+) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Telegram Bot (optional — admin notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Email via Resend (optional — order notifications) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ADMIN=

# --- Cron / scheduled jobs (required in production runtime) ---
# Generate: openssl rand -base64 32
CRON_SECRET=

# --- Error monitoring (optional) ---
SENTRY_DSN=
