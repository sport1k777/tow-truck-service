# =============================================================================
# Tow Truck Service — Production Environment Reference
# Copy to .env.production.local (Vercel) or /etc/tow-truck-service.env (VPS)
# Never commit real secrets to git.
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://evakuator24.biz.ua

# Required at runtime
DATABASE_URL=postgresql://user:password@host:5432/tow_truck_service?sslmode=require
AUTH_SECRET=
AUTH_URL=https://evakuator24.biz.ua
CRON_SECRET=

# Strongly recommended
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional integrations
GOOGLE_MAPS_SERVER_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ADMIN=
SENTRY_DSN=

# Vercel: set in Project → Settings → Environment Variables (Production)
# VPS:   source this file in systemd unit or docker-compose env_file
