{
  "name": "tow-truck-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:production": "prisma generate && next build",
    "start": "next start",
    "start:production": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cd .next/standalone && NODE_ENV=production node server.js",
    "verify": "npm run type-check && npm run build:production",
    "verify:rc": "npm run lint && npm run type-check && npm run build:production",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:migrate-hero-image": "tsx scripts/migrate-hero-image-url.ts",
    "db:studio": "prisma studio",
    "env:check": "tsx scripts/validate-env.ts",
    "postinstall": "node scripts/prisma-generate-if-present.js"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.475.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "prisma": "^6.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/google.maps": "^3.65.4",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
